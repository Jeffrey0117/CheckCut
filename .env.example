# CheckCut Server Configuration
PORT=4010
NODE_ENV=development

# Session Secret (change in production!)
SESSION_SECRET=change-me-in-production

# Database
DATABASE_PATH=./data/checkcut.db

# Hotlink Protection — comma-separated allowed origins
# Traffic from these domains can access video streams
ALLOWED_ORIGINS=https://kuangrenshuo.com,https://www.kuangrenshuo.com

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5175

# SeedBlog Integration — fetch articles for person profiles
SEEDBLOG_BASE_URL=http://localhost:4026
SEEDBLOG_TOKEN=
