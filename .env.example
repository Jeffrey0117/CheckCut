# CheckCut Server Configuration
PORT=4010
NODE_ENV=development

# Session Secret (change in production!)
SESSION_SECRET=change-me-in-production

# Database
DATABASE_PATH=./data/checkcut.db

# Hotlink Protection — comma-separated allowed origins
# Traffic from these domains can access video streams
ALLOWED_ORIGINS=https://kuangrenshuo.com,https://www.kuangrenshuo.com

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5175

# SeedBlog Integration — fetch articles for person profiles
SEEDBLOG_BASE_URL=http://localhost:4026
SEEDBLOG_TOKEN=

# Public base URL — used to build absolute embed/stream URLs returned by the
# upload API. If unset, derived from the incoming request.
PUBLIC_URL=https://checkcut.isnowfriend.com

# Server-to-server upload API key. Trusted callers (e.g. CourseBloom) send this
# as `X-API-Key` to POST /api/v1/upload. MUST be set for uploads to work.
CHECKCUT_API_KEY=change-me-strong-random

# Max upload size in bytes (default 500MB)
MAX_UPLOAD_SIZE=524288000

# Pokkit storage backend — where uploaded video files are actually stored.
POKKIT_URL=https://pokkit.isnowfriend.com
POKKIT_API_KEY=change-me-pokkit-key
