{
  "name": "checkcut",
  "version": "1.0.0",
  "description": "CheckCut - Curated video platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "build:full": "npm install --production=false && cd client && npm install && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/scripts/seed.js",
    "seed:force": "node server/scripts/seed.js --force",
    "seed:clear": "node server/scripts/seed.js --clear",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
"dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
